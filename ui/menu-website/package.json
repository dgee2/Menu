{
  "name": "menu-website",
  "version": "0.0.1",
  "description": "Menu website",
  "productName": "Menu",
  "author": "Daniel Gee <dan@dan-gee.co.uk>",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "aspire": "vite --strictPort",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "lint": "eslint . \"./src/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint-fix": "eslint . \"./src/**/*.{ts,js,cjs,mjs,vue}\" --fix",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest --run --coverage --passWithNoTests",
    "test:unit": "vitest --project=unit --run",
    "test:e2e": "playwright test",
    "test:storybook": "vitest --project=storybook --run",
    "type-check": "vue-tsc --build --noEmit",
    "generate-openapi": "openapi-typescript ../../open-api/menu-api.json --output ./src/generated/open-api/menu-api.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.13.0",
    "@quasar/extras": "^2.1.0",
    "@tanstack/vue-query": "^5.107.1",
    "@tanstack/vue-query-devtools": "^6.4.1",
    "autoprefixer": "^10.6.2",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@quasar/app-vite": "^3.10.4",
    "@quasar/vite-plugin": "^2.0.2",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-vue": "~10.12.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "msw-storybook-addon": "^3.0.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "sass-embedded": "^1.108.2",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">= 6.13.4",
    "pnpm": ">= 10",
    "yarn": ">= 1.21.1"
  },
  "volta": {
    "node": "22.22.2",
    "pnpm": "11.21.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
